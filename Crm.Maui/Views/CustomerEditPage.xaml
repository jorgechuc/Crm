<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodel="clr-namespace:Crm.Maui.ViewModels"
             x:Class="Crm.Maui.Views.CustomerEditPage"
             Title="Nuevo contacto">

    <ContentPage.BindingContext>
        <viewmodel:CustomerEditViewModel/>
    </ContentPage.BindingContext>
    
    <Grid
        Padding="16">

        <VerticalStackLayout
            VerticalOptions="Start">
            <Label
                Text="Nombre del contacto:"/>
            <Entry
                Text="{Binding Path=Cust.FirstName}"
                Placeholder="P.je., John"
                Margin="0,0,0,16"
                BackgroundColor="WhiteSmoke"/>
            <Label
                Text="Apellidos del contacto:"/>
            <Entry
                Text="{Binding Path=Cust.LastName}"
                Placeholder="P.Ej., Doe"
                Margin="0,0,0,16"
                BackgroundColor="WhiteSmoke"/>
            <Label
                Text="Correo electrónico del contacto:"/>
            <Entry
                Text="{Binding Path=Cust.Email}"
                Placeholder="P.ej., jdoe@example.com"
                Margin="0,0,0,32"
                BackgroundColor="WhiteSmoke"/>
            <Button
                Text="Guardar"
                Command="{Binding Path=SaveCommand}"/>
        </VerticalStackLayout>
        
    </Grid>

</ContentPage>